rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the certificates collection
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Match any other documents
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
